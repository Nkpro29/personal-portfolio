# Public site URL used for canonical / Open Graph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Postgres (pooled connection for the app)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for Prisma migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — server-side only. Never expose this to the client.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional social / contact links. Leave empty until real URLs exist.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional looping hero video (mp4). Leave empty to use the animated fallback.
NEXT_PUBLIC_HERO_VIDEO_URL=
